{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["DOM", "ES2020"],
    "strict": true,
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "playwright"],
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "tests",
    "playwright.config.ts"
  ]
}
